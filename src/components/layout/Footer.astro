---
import { getSiteContent } from "../../data/dataLayer";
const content = getSiteContent();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={content.brand.logoPath} alt="SHC" />
      <span class="footer-copy">© {year} SHC · מערכות לארגונים ומוסדות</span>
    </div>

    <nav class="footer-links">
      <a href="#systems">מערכות</a>
      <a href="#process">תהליך</a>
      <a href="#portfolio">עבודות</a>
      <a href="#contact">צור קשר</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: #0D1420;
    border-top: 1px solid oklch(22% 0.03 224);
    padding: 28px 48px;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin-inline: auto;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-brand img {
    height: 28px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.5;
  }

  .footer-copy {
    font-size: 13px;
    color: oklch(45% 0.04 224);
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    font-size: 13px;
    color: oklch(52% 0.05 224);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: oklch(65% 0.14 220);
  }

  @media (max-width: 900px) {
    .site-footer {
      padding: 24px 20px;
    }

    .footer-inner {
      flex-direction: column;
      gap: 14px;
      text-align: center;
    }
  }
</style>
